<Window
    x:Class="ScreenViewer.WinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Screen Viewer"
    >
    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded" AllowDrop="True" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="BrowserColumn" Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <MenuBar Grid.Row="0" Grid.ColumnSpan="2">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="Exit" Click="Exit_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Edit">
                <MenuFlyoutItem Text="Paste" Click="Paste_Click" />
            </MenuBarItem>
            <MenuBarItem Title="View">
                <ToggleMenuFlyoutItem x:Name="AlwaysOnTopMenuItem" Text="Always on top" Click="AlwaysOnTopMenuItem_Click" />
                <ToggleMenuFlyoutItem x:Name="AllowMultipleMenuItem" Text="Allow multiple images" Click="AllowMultipleMenuItem_Click" />
                <ToggleMenuFlyoutItem x:Name="BrowserMenuItem" Text="Image browser" Click="BrowserMenuItem_Click" />
            </MenuBarItem>
        </MenuBar>

        <Border x:Name="BrowserPanel" Grid.Row="1" Grid.Column="0" Background="#FF11151A" BorderBrush="#FF252B33" BorderThickness="0,0,1,0" Padding="12">
            <StackPanel Spacing="8">
                <Button Content="Browse Folder..." Click="BrowseFolder_Click" />
                <TextBox x:Name="FilterBox" PlaceholderText="Filter files..." TextChanged="FilterBox_TextChanged" />
                <ListView x:Name="BrowserListView" ItemsSource="{Binding BrowserImages}" IsItemClickEnabled="True" ItemClick="BrowserListView_ItemClick" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Background="#FF0D0F12" Padding="12">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ComboBox x:Name="DisplayComboBox" Width="260" DisplayMemberPath="Label" SelectionChanged="DisplayComboBox_SelectionChanged" ItemsSource="{Binding Displays}" />
                    <ToggleButton x:Name="AlwaysOnTopToggle" Content="Always on top" Checked="AlwaysOnTopToggle_Checked" Unchecked="AlwaysOnTopToggle_Unchecked" />
                    <ToggleButton x:Name="AllowMultipleToggle" Content="Allow multiple images" Checked="AllowMultipleToggle_Checked" Unchecked="AllowMultipleToggle_Unchecked" />
                    <ToggleButton x:Name="BrowserToggle" Content="Image browser" Checked="BrowserToggle_Checked" Unchecked="BrowserToggle_Unchecked" />
                    <Button Content="Paste" Click="Paste_Click" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Border CornerRadius="10" Background="#FF050608" BorderBrush="#FF2B3138" BorderThickness="1">
                        <Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding ActiveImages}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" />
                </Grid>

                <TextBlock x:Name="StatusTextBlock" Grid.Row="2" Text="Ready" Foreground="#D0D8E3" Opacity="0.8" />
            </Grid>
        </Border>
    </Grid>
</Window>
