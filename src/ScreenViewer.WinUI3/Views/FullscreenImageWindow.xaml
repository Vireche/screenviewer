<Window
    x:Class="ScreenViewer.WinUI3.Views.FullscreenImageWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ScreenViewer.WinUI3.Models"
    xmlns:local="using:ScreenViewer.WinUI3.Views">
    <Grid x:Name="RootGrid" Background="Black" Loaded="RootGrid_Loaded" KeyDown="RootGrid_KeyDown" TabFocusNavigation="Cycle">
        <Grid x:Name="SingleImageHost" Visibility="Collapsed">
            <Image x:Name="SingleImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <Grid x:Name="MultiImageHost" Visibility="Collapsed" Margin="12" />
    </Grid>
</Window>
